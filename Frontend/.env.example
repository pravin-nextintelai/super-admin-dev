# Copy to .env.local (git-ignored). All values are optional — defaults are in src/config/config.js.
# Backend API base. On localhost the Vite proxy forwards /api → VITE_DEV_PROXY_TARGET, so this can stay empty.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:4000
# Customer app (referral signup links)
VITE_CUSTOMER_APP_URL=https://jurinex-dev.netlify.app
VITE_CUSTOMER_APP_LOCAL_URL=http://localhost:5173
# Other services
VITE_JUDGEMENT_SERVICE_URL=
VITE_JUDGEMENT_UPLOAD_MAX_FILES=
VITE_LIBRARY_UPLOAD_MAX_FILES=
VITE_ANALYSIS_API_URL=
VITE_TEMPLATE_ANALYZER_BASE_URL=
